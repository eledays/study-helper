COMPOSE_FILE=compose.yaml:compose.prod.yaml
ENVIRONMENT=production
DEBUG=false
COOKIE_SECURE=true
BASE_URL=https://study.example.com
# For a reverse proxy on another machine, use this server's LAN address.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
BOT_TOKEN=
BOT_PROXY_URL=
BOT_USERNAME=
SECRET_KEY=
DATABASE_URL=sqlite:////app/data/study.db
RELEASE_TAG=local
BACKUP_DIR=./backups
